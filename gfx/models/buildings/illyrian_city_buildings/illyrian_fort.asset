pdxmesh = {
	name = "illyrian_fort_mesh"
	file = "illyrian_fort.mesh"

	meshsettings = {
		name = "pelasgian_fortShape"
		index = 0
		texture_diffuse = "illyrian_buildings_diffuse.dds"
		texture_normal = "illyrian_buildings_normal.dds"
		texture_specular = "illyrian_buildings_properties.dds"
		shader = "standard_snow"
		shader_file = "gfx/FX/pdxmesh.shader"
	}

	meshsettings = {
		name = "pelasgian_fort_rockShape"
		index = 0
		texture_diffuse = "illyrian_fort_rock_diffuse.dds"
		texture_normal = "wonder_acropolis_rock_normal.dds"
		texture_specular = "wonder_acropolis_rock_properties.dds"
		shader = "standard_snow"
		shader_file = "gfx/FX/pdxmesh.shader"
	}
}

entity = {
	name = "illyrian_gfx_fort_entity"
	pdxmesh = "illyrian_fort_mesh"
	default_state = "default"

	state = {
		name = default
		start_event = { trigger_once = yes sound = { soundeffect = "event:/SFX/Ambience/3DMapEmitters/Military/sfx_amb_3d_military_fort_tribal" } keep_sound = yes }
	}
}
